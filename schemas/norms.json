      "mean": 0.5,
      "std": 0.2,
      "unit": "coefficient_of_variation",
      "direction": "lower_is_better",
      "clinical_note": "Lower CV indicates more regular blinking"
    },
    "blink_burstiness": {
      "mean": 0.2,
      "std": 0.15,
      "unit": "proportion",
      "direction": "neutral",
      "clinical_note": "Higher values indicate clustered blinking"
    },
    "gaze_presence_pct": {
      "mean": 85.0,
      "std": 10.0,
      "unit": "percent",
      "direction": "higher_is_better"
    }
  },
  "derived": {
    "oculomotor_health_score": {
      "mean": 0.75,
      "std": 0.15,
      "unit": "score",
      "direction": "higher_is_better"
    },
    "inhibitory_control_index": {
      "mean": 0.85,
      "std": 0.10,
      "unit": "score",
      "direction": "higher_is_better"
    },
    "pursuit_quality": {
      "mean": 0.80,
      "std": 0.15,
      "unit": "score",
      "direction": "higher_is_better"
    },
    "fixation_quality": {
      "mean": 0.80,
      "std": 0.15,
      "unit": "score",
      "direction": "higher_is_better"
    },
    "blink_regularity": {
      "mean": 0.50,
      "std": 0.20,
      "unit": "score",
      "direction": "higher_is_better"
    }
  }
